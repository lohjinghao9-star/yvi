<!-- Three.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
/* ============ 3D BACKGROUND ============ */
const canvas = document.getElementById('bg3d');
const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
renderer.setSize(innerWidth, innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));

const scene = new THREE.Scene();
scene.fog = new THREE.FogExp2(0x06070d, 0.035);

const camera = new THREE.PerspectiveCamera(60, innerWidth / innerHeight, 0.1, 100);
camera.position.z = 14;

/* Lights */
scene.add(new THREE.AmbientLight(0x404060, 1.2));
const p1 = new THREE.PointLight(0x6c5ce7, 2, 50); p1.position.set(6, 4, 6); scene.add(p1);
const p2 = new THREE.PointLight(0x00d2ff, 2, 50); p2.position.set(-6, -3, 5); scene.add(p2);

/* Central torus knot */
const knot = new THREE.Mesh(
  new THREE.TorusKnotGeometry(2.2, 0.55, 180, 24),
  new THREE.MeshStandardMaterial({
    color: 0x6c5ce7, metalness: 0.85, roughness: 0.25,
    emissive: 0x1a1440, emissiveIntensity: 0.6
  })
);
knot.position.x = 4.5;
scene.add(knot);

/* Floating wireframe shapes */
const shapes = [];
const geos = [
  new THREE.IcosahedronGeometry(1, 0),
  new THREE.OctahedronGeometry(1, 0),
  new THREE.TorusGeometry(0.8, 0.3, 12, 30)
];
for (let i = 0; i < 14; i++) {
  const m = new THREE.Mesh(
    geos[i % 3],
    new THREE.MeshBasicMaterial({ color: i % 2 ? 0x00d2ff : 0x6c5ce7, wireframe: true, transparent: true, opacity: 0.35 })
  );
  m.position.set((Math.random() - 0.5) * 26, (Math.random() - 0.5) * 18, (Math.random() - 0.5) * 14 - 4);
  m.userData = {
    rotX: (Math.random() - 0.5) * 0.01,
    rotY: (Math.random() - 0.5) * 0.01,
    floatSpeed: 0.3 + Math.random() * 0.5,
    floatOffset: Math.random() * Math.PI * 2,
    baseY: m.position.y
  };
  shapes.push(m);
  scene.add(m);
}

/* Particle field */
const pCount = 1400;
const positions = new Float32Array(pCount * 3);
for (let i = 0; i < pCount * 3; i++) positions[i] = (Math.random() - 0.5) * 50;
const pGeo = new THREE.BufferGeometry();
pGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
const particles = new THREE.Points(pGeo, new THREE.PointsMaterial({
  color: 0x8890ff, size: 0.045, transparent: true, opacity: 0.7
}));
scene.add(particles);

/* Mouse parallax */
let mx = 0, my = 0, tx = 0, ty = 0;
addEventListener('mousemove', e => {
  mx = (e.clientX / innerWidth - 0.5) * 2;
  my = (e.clientY / innerHeight - 0.5) * 2;
});

/* Scroll offset for camera drift */
let scrollY = 0;
addEventListener('scroll', () => scrollY = window.scrollY);

/* Animate */
const clock = new THREE.Clock();
function animate() {
  requestAnimationFrame(animate);
  const t = clock.getElapsedTime();

  knot.rotation.x = t * 0.25;
  knot.rotation.y = t * 0.35;
  knot.position.y = Math.sin(t * 0.6) * 0.6;

  shapes.forEach(s => {
    s.rotation.x += s.userData.rotX;
    s.rotation.y += s.userData.rotY;
    s.position.y = s.userData.baseY + Math.sin(t * s.userData.floatSpeed + s.userData.floatOffset) * 0.8;
  });

  particles.rotation.y = t * 0.02;

  tx += (mx - tx) * 0.04;
  ty += (my - ty) * 0.04;
  camera.position.x = tx * 1.5;
  camera.position.y = -ty * 1.2 - scrollY * 0.004;
  camera.lookAt(0, -scrollY * 0.004, 0);

  renderer.render(scene, camera);
}
animate();

addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});

/* ============ SCROLL REVEAL ============ */
const io = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.classList.add('visible');
      io.unobserve(e.target);
    }
  });
}, { threshold: 0.12 });
document.querySelectorAll('.reveal').forEach(el => io.observe(el));

/* ============ COUNTER ANIMATION ============ */
const counterIO = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (!e.isIntersecting) return;
    const el = e.target, target = +el.dataset.count;
    let cur = 0;
    const step = () => {
      cur += Math.ceil(target / 50);
      if (cur >= target) { el.textContent = target + '+'; return; }
      el.textContent = cur;
      requestAnimationFrame(step);
    };
    step();
    counterIO.unobserve(el);
  });
}, { threshold: 0.5 });
document.querySelectorAll('[data-count]').forEach(el => counterIO.observe(el));
</script>
</body>
</html>
