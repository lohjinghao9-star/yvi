<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NOVA Studio — Web Development & Design</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --bg: #06070d;
    --accent: #6c5ce7;
    --accent2: #00d2ff;
    --text: #eef0f6;
    --muted: #9aa0b5;
    --glass: rgba(255,255,255,0.05);
    --border: rgba(255,255,255,0.1);
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Segoe UI', system-ui, sans-serif;
    overflow-x: hidden;
  }

  /* ---------- 3D Canvas ---------- */
  #bg3d {
    position: fixed;
    inset: 0;
    z-index: 0;
  }

  /* ---------- Nav ---------- */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 6vw;
    backdrop-filter: blur(14px);
    background: rgba(6,7,13,0.35);
    border-bottom: 1px solid var(--border);
    transition: padding .3s;
  }

  .logo {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: 3px;
    background: linear-gradient(90deg, var(--accent2), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  nav ul {
    display: flex;
    gap: 36px;
    list-style: none;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: .92rem;
    letter-spacing: 1px;
    transition: color .25s;
  }
  nav a:hover { color: var(--text); }

  .nav-cta {
    padding: 10px 22px;
    border-radius: 40px;
    border: 1px solid var(--accent);
    color: var(--text) !important;
    transition: all .3s;
  }
  .nav-cta:hover {
    background: var(--accent);
    box-shadow: 0 0 25px rgba(108,92,231,.5);
  }

  /* ---------- Sections ---------- */
  section {
    position: relative;
    z-index: 1;
    padding: 130px 6vw;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ---------- Hero ---------- */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 1200px;
  }

  .hero .tag {
    display: inline-block;
    width: fit-content;
    padding: 8px 18px;
    border-radius: 30px;
    border: 1px solid var(--border);
    background: var(--glass);
    color: var(--accent2);
    font-size: .8rem;
    letter-spacing: 2px;
    margin-bottom: 28px;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 7vw, 5.2rem);
    line-height: 1.08;
    font-weight: 800;
    max-width: 800px;
  }

  .hero h1 span {
    background: linear-gradient(90deg, var(--accent2), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero p {
    margin-top: 24px;
    color: var(--muted);
    font-size: 1.15rem;
    max-width: 520px;
    line-height: 1.7;
  }

  .hero-btns { margin-top: 42px; display: flex; gap: 18px; flex-wrap: wrap; }

  .btn {
    padding: 15px 34px;
    border-radius: 40px;
    font-size: .95rem;
    letter-spacing: 1px;
    cursor: pointer;
    text-decoration: none;
    transition: all .3s;
    border: none;
  }
  .btn-primary {
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    color: #fff;
    font-weight: 600;
  }
  .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(108,92,231,.45); }
  .btn-ghost {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
  }
  .btn-ghost:hover { border-color: var(--accent2); color: var(--accent2); }

  .scroll-hint {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--muted);
    font-size: .75rem;
    letter-spacing: 3px;
    animation: bob 2s infinite ease-in-out;
  }
  @keyframes bob { 50% { transform: translate(-50%, 8px); } }

  /* ---------- Section headings ---------- */
  .sec-label {
    color: var(--accent2);
    font-size: .8rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  h2 {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    font-weight: 800;
    margin-bottom: 60px;
  }

  /* ---------- Services ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .card {
    background: var(--glass);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 38px 30px;
    backdrop-filter: blur(10px);
    transition: transform .35s, border-color .35s, box-shadow .35s;
  }
  .card:hover {
    transform: translateY(-8px);
    border-color: rgba(108,92,231,.6);
    box-shadow: 0 20px 50px rgba(108,92,231,.18);
  }
  .card .icon {
    font-size: 2rem;
    width: 62px; height: 62px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(108,92,231,.25), rgba(0,210,255,.15));
    margin-bottom: 22px;
  }
  .card h3 { font-size: 1.2rem; margin-bottom: 12px; }
  .card p { color: var(--muted); line-height: 1.65; font-size: .95rem; }

  /* ---------- Stats ---------- */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 24px;
    text-align: center;
  }
  .stat {
    padding: 40px 20px;
    border-radius: 20px;
    background: var(--glass);
    border: 1px solid var(--border);
  }
  .stat .num {
    font-size: 2.6rem;
    font-weight: 800;
    background: linear-gradient(90deg, var(--accent2), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat .lbl { color: var(--muted); margin-top: 8px; font-size: .9rem; letter-spacing: 1px; }

  /* ---------- Work ---------- */
  .work-item {
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--glass);
    margin-bottom: 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    transition: transform .35s;
  }
  .work-item:hover { transform: scale(1.015); }
  .work-visual {
    min-height: 260px;
    background: linear-gradient(135deg, rgba(108,92,231,.35), rgba(0,210,255,.15));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
  }
  .work-info { padding: 44px 38px; display: flex; flex-direction: column; justify-content: center; }
  .work-info h3 { font-size: 1.4rem; margin-bottom: 12px; }
  .work-info p { color: var(--muted); line-height: 1.65; }
  .work-info .link { margin-top: 20px; color: var(--accent2); text-decoration: none; font-size: .9rem; letter-spacing: 1px; }

  /* ---------- Contact ---------- */
  .contact-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: start;
  }
  form { display: flex; flex-direction: column; gap: 16px; }
  input, textarea {
    background: var(--glass);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 16px 18px;
    color: var(--text);
    font-family: inherit;
    font-size: .95rem;
    outline: none;
    transition: border-color .3s;
    resize: vertical;
  }
  input:focus, textarea:focus { border-color: var(--accent); }
  .contact-info p { color: var(--muted); line-height: 1.8; margin-bottom: 24px; }
  .contact-info a { color: var(--accent2); text-decoration: none; }

  footer {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 36px;
    color: var(--muted);
    font-size: .85rem;
    border-top: 1px solid var(--border);
  }

  /* ---------- Reveal animation ---------- */
  .reveal { opacity: 0; transform: translateY(40px); transition: all .8s cubic-bezier(.2,.7,.3,1); }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  /* ---------- Responsive ---------- */
  @media (max-width: 820px) {
    nav ul { display: none; }
    .work-item { grid-template-columns: 1fr; }
    .contact-wrap { grid-template-columns: 1fr; }
  }
</style>
</head>
